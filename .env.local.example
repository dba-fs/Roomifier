# Roomifier — environment variables
#
# Copy this file to `.env.local` (gitignored, never committed)
#
# This is the author's own deployed Puter Worker (lib/puter.worker.js). It's safe
# to share as-is: the worker is multi-tenant — every request runs under whoever is
# signed in via puter.auth.signIn() in the browser, not under the deploying account.
# Each user's projects are stored in their own Puter KV/FS space.
#
# Only redeploy your own worker if you're changing puter.worker.js itself.
VITE_PUTER_WORKER_URL=https://roomifier.puter.work